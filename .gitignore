# Google Services (e.g. APIs or Firebase)
google-services.json

# Local configuration file (sdk path, etc)
local.properties
gradle.properties

# Keystore files — never commit release signing keys.
# Provide release keystore + passwords via environment variables / CI secrets
# (KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD) at build time.
*.jks
*.keystore
*.p12
*.pfx
**/.cxx/
